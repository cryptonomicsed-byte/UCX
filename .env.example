# UCX broker environment variables
# Copy to .env and fill in real values before running.

# Zàngbétò witness service — used to anchor ComputeReceipts into the
# sovereign settlement chain.  Without this, receipts are still issued
# but carry no zangbeto_anchor and earn Àṣẹ at reduced trust level.
ZANGBETO_URL=http://localhost:8787

# OSOVM event bridge — receives GPU_CONTRIBUTION events for TOC_MINT.
OSOVM_URL=http://127.0.0.1:7780

# UCX broker self-URL (used by Vantage-discovered provider proxies).
UCX_BROKER_URL=http://127.0.0.1:7790

# Vantage API base URL and API key for provider discovery.
# VANTAGE_URL=https://vantage.example.com
# VANTAGE_API_KEY=your_key_here

# GPU.ai adapter credentials (enable with --features gpu-ai).
# GPUAI_API_KEY=gpuai_live_...
